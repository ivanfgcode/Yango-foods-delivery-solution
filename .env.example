# Copiar a .env en local. En Railway van como variables del servicio. Nunca commitear secretos.
PUBLIC_BASE_URL=https://pedidos.ejemplo.bo
ADMIN_KEY=cambiar
SECRET_KEY=cambiar-por-un-valor-largo-aleatorio

# mock (simulado) | yango_web (food.yango.com real con Playwright)
YANGO_SOURCE=yango_web
# Sin cookies cargadas, ver food.yango.com sin sesión (solo restaurantes públicos). Solo pruebas.
ALLOW_ANONYMOUS=false
PAGES_PER_ACCOUNT=2
MAX_INFLIGHT_PER_ACCOUNT=12

# El bot crea el pedido en Yango. Apagado: queda «manual» y se avisa por Telegram.
ORDER_PLACEMENT_ENABLED=false
FEE_TOLERANCE=2

# Ventas (botón de WhatsApp de la landing) y cómo se liquida la comisión
SALES_WHATSAPP=
COMMISSION_PAYMENT_INFO=La comisión se liquida con Yango a fin de mes. En Pedidos ves la comisión de cada pedido.

# Upselling: días de pedidos que se miran y mínimo de veces juntos para sugerir un producto
UPSELL_DAYS=90
UPSELL_MIN_PAIRS=2

# Modelo comercial: comisión sobre el subtotal (la paga el restaurante a Yango), sin cargos fijos al cliente.
COMMISSION_RATE=0.03
CHARGE_SERVICE_FEE=false
# Envío: model = tramos por distancia (mín–máx según distancia y demanda) | yango = envío cotizado por Yango
DELIVERY_FEE_MODE=model
DELIVERY_TIERS=1:5-10,3:10-15,inf:15-25
DELIVERY_MAX_KM=8
DELIVERY_DEMAND_WEIGHT=0.4

# Mapa del checkout (Yandex Maps). Opcional: sin clave también carga. es_ES | en_US
YANDEX_MAPS_API_KEY=
YANDEX_MAPS_LANG=es_ES
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEMO_SEED=false

# Seguimiento de pedidos y avisos push al cliente. VAPID_PRIVATE_KEY (PEM, \n escapados) fija las claves entre
# despliegues; sin ella se generan en data/vapid.json (en un volumen persistente basta).
TRACKING_SECONDS=30
TRACKING_HOURS=4
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@carta.bo
ADMIN_KEYS_EXTRA=   # claves de admin adicionales (mín. 24 caracteres, separadas por coma)
